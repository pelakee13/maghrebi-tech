# Public site URL (used for canonical, sitemap, Open Graph)
SITE_URL=https://maghrebi.tech

# Optional: Cloudflare Turnstile (spam protection). Leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email delivery (Resend — https://resend.com). REQUIRED for the contact form:
# without RESEND_API_KEY every submission fails loudly and shows the visitor an error.
RESEND_API_KEY=
CONTACT_TO_EMAIL=amin.mb21@gmail.com
# Use a form@maghrebi.tech address once the domain is verified in Resend;
# until then the code falls back to Resend's onboarding@resend.dev sender.
CONTACT_FROM_EMAIL=
